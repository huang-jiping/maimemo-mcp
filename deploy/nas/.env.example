# Replace every placeholder locally. Never commit the resulting .env file.
MAIMEMO_DATABASE_URL=postgresql+psycopg://maimemo:REPLACE_WITH_URL_ENCODED_PASSWORD@replace-with-db-net-dns.invalid:5432/maimemo?sslmode=disable
MAIMEMO_SERVER_IMAGE=ghcr.io/huang-jiping/maimemo-server@sha256:REPLACE_WITH_64_HEX_DIGEST
MAIMEMO_MCP_IMAGE=ghcr.io/huang-jiping/maimemo-mcp@sha256:REPLACE_WITH_64_HEX_DIGEST
MAIMEMO_WORKER_IMAGE=ghcr.io/huang-jiping/maimemo-worker@sha256:REPLACE_WITH_64_HEX_DIGEST
MAIMEMO_TIMEZONE=Asia/Shanghai
MAIMEMO_LOG_LEVEL=INFO
MAIMEMO_TODAY_INTERVAL_MINUTES=30
MAIMEMO_RECORDS_INTERVAL_MINUTES=120
MAIMEMO_SCHEMA_WAIT_TIMEOUT_SECONDS=60
