# Copy beside the UGOS project compose.yaml. Fill credentials only in local .env.
# Replace both placeholders locally; use the PostgreSQL Docker DNS alias on db_net.
# Database and application user are maimemo. Port 5432 is the container port.
MAIMEMO_DATABASE_URL=postgresql+psycopg://maimemo:REPLACE_WITH_URL_ENCODED_PASSWORD@replace-with-db-net-dns.invalid:5432/maimemo?sslmode=disable
IMAGE_TAG=stable
TZ=Asia/Shanghai
MAIMEMO_TOKEN_FILE=/run/secrets/maimemo_token
MAIMEMO_TOKEN_FINGERPRINT_KEY_FILE=/run/secrets/token_fingerprint_key
MAIMEMO_TIMEZONE=Asia/Shanghai
MAIMEMO_MCP_HOST=0.0.0.0
MAIMEMO_MCP_PORT=8000
MAIMEMO_MCP_ALLOWED_HOSTS=maimemo-mcp
MAIMEMO_TODAY_INTERVAL_MINUTES=30
MAIMEMO_RECORDS_INTERVAL_MINUTES=120
MAIMEMO_LOG_LEVEL=INFO
MAIMEMO_OPENAPI_DRIFT_STATE_FILE=/var/lib/maimemo/openapi-drift.json
