# Copy beside the NAS compose.yaml, outside app/. Fill credentials only in .env.
# Replace postgresql with the existing database container DNS name on db_net.
MAIMEMO_DATABASE_URL=postgresql+psycopg://postgresql/maimemo
IMAGE_TAG=dev
TZ=Asia/Shanghai
MAIMEMO_TOKEN_FILE=/run/secrets/maimemo_token
MAIMEMO_TOKEN_FINGERPRINT_KEY_FILE=/run/secrets/token_fingerprint_key
MAIMEMO_TIMEZONE=Asia/Shanghai
MAIMEMO_MCP_HOST=0.0.0.0
MAIMEMO_MCP_PORT=8000
MAIMEMO_MCP_ALLOWED_HOSTS=maimemo-mcp
MAIMEMO_TODAY_INTERVAL_MINUTES=30
MAIMEMO_RECORDS_INTERVAL_MINUTES=120
MAIMEMO_LOG_LEVEL=INFO
MAIMEMO_OPENAPI_DRIFT_STATE_FILE=/var/lib/maimemo/openapi-drift.json
