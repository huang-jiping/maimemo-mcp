# Images are independently deployable but share one release version.
MAIMEMO_SERVER_IMAGE=ghcr.io/huang-jiping/maimemo-server:0.2.0
MAIMEMO_MCP_IMAGE=ghcr.io/huang-jiping/maimemo-mcp:0.2.0
MAIMEMO_WORKER_IMAGE=ghcr.io/huang-jiping/maimemo-worker:0.2.0

# Supply the existing PostgreSQL connection; do not commit its real password.
MAIMEMO_DATABASE_URL=postgresql+psycopg://maimemo:change-me@postgres.example:5432/maimemo
MAIMEMO_TIMEZONE=Asia/Shanghai
MAIMEMO_LOG_LEVEL=INFO
MAIMEMO_TODAY_INTERVAL_MINUTES=30
MAIMEMO_RECORDS_INTERVAL_MINUTES=120

# Host paths read by Docker Compose and mounted only into MCP and Worker.
MAIMEMO_TOKEN_SECRET_FILE=./secrets/maimemo_token
MAIMEMO_TOKEN_FINGERPRINT_KEY_SECRET_FILE=./secrets/token_fingerprint_key

# Use these only with compose.proxy.example.yaml after the proxy network exists.
MAIMEMO_EXTERNAL_BASE_URL=https://maimemo.huangjiping.com
MAIMEMO_PROXY_NETWORK=replace-with-confirmed-proxy-network
